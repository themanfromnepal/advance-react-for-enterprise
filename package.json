{
  "name": "@akashalmujahidaljabali/core",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lerna": "^9.0.0"
  },
  "private": true,
  "packageManager": "yarn@4.11.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "playgrounds/*"
    ]
  },
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "build": "yarn lerna run build",
    "dev": "lerna run dev --include-dependencies --parallel",
    "lint": "lerna run lint",
    "lint:fix": "lerna run lint:fix",
    "test": "yarn lerna run test",
    "publish": "yarn test && yarn build && yarn lerna publish",
    "commit": "yarn git-cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
